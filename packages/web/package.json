{
  "name": "@odbvue/web",
  "description": "OdbVue web runtime and configuration API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "oxfmt",
    "lint": "oxlint",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm format && pnpm lint && pnpm type-check && pnpm test:run"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@mdi/js": "^7.4.47",
    "@unhead/vue": "^3.1.4",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.2",
    "vite": "^8.0.16",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "vitest": "^4.1.9",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
