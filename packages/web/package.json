{
  "name": "@odbvue/web",
  "description": "OdbVue web runtime and configuration API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "oxfmt",
    "lint": "oxlint",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm format && pnpm lint && pnpm type-check && pnpm test:run"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "vitest": "^4.1.9",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
