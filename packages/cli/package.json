{
  "name": "@odbvue/cli",
  "description": "OdbVue CLI",
  "bin": {
    "ov": "dist/index.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "link": "pnpm link --global",
    "unlink": "pnpm unlink --global",
    "format": "oxfmt",
    "lint": "oxlint",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm format && pnpm lint && pnpm type-check"
  },
  "dependencies": {
    "@types/oracledb": "^6.10.3",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "oci-common": "^2.116.0",
    "oci-database": "^2.130.0",
    "oci-identity": "^2.116.0",
    "oracledb": "^6.10.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/prompts": "^2.4.9"
  }
}
