{
    "postman.settings.dotenv-detection-notification-visibility": false,
    "cSpell.words": [
        "autoimport",
        "odbvue",
        "Ords",
        "Unhead",
        "vuetify"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "tsconfig.json": "tsconfig.*.json, env.d.ts, typed-router.d.ts, auto-imports.d.ts, components.d.ts",
        "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*, vite-plugin-*",
        "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .oxfmt*, .prettier*, prettier*, .editorconfig"
    }
}